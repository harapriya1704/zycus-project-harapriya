# Copy to `.env` and fill in. Config is read with the INV_ prefix;
# the OpenAI-compatible provider credentials are read from OPENAI_*.

# ── LLM provider (Groq in production) ─────────────────────────────────
# Groq is OpenAI-compatible. Set these to the values provided by Groq.
# Vision defaults to the multimodal qwen/qwen3.8-27b; text structuring to
# openai/gpt-oss-120b. Override with INV_* below.
OPENAI_API_KEY=gsk_...
OPENAI_BASE_URL=https://api.groq.com/openai/v1

# ── Extraction (vision transcription) ─────────────────────────────────
# Model that transcribes image-only pages (must support vision/image_url
# input — a text-only model fails on base64/image payloads).
# Read from INV_VISION_MODEL.
INV_VISION_MODEL=qwen/qwen3.8-27b
INV_EXTRACTION_TEMPERATURE=0.0

# ── Structuring (document text -> autodraft JSON) ─────────────────────
# Shared by the day-1 structuring chain and the day-2 corrector agent.
# Text-only is fine here; no images reach this model.
INV_STRUCTURING_MODEL=openai/gpt-oss-120b
INV_STRUCTURING_TEMPERATURE=0.0

# Default text-reasoning model (effective when INV_STRUCTURING_MODEL is
# empty). Groq serves the openai gpt-oss weights. qwen/qwen3.8-27b was
# dropped as the default because its free-tier OTPM (1000 output tokens per
# minute) truncated long invoices and its TPD budget exhausted mid-batch.
INV_TEXT_MODEL=openai/gpt-oss-120b
INV_TEXT_BASE_URL=https://api.groq.com/openai/v1

# Output token window for one text-reasoning call. gpt-oss expands each line
# item into its own JSON object (4k-8k output tokens on long invoices), so a
# smaller cap clips the payload and yields empty payables (false negative).
# 8192 also feeds the multi-agent validation/corrector loop.
INV_TEXT_MAX_TOKENS=8192

# Cap (chars) on the document text sent to the structuring LLM (precision
# mode). 0 = unlimited. Oversized multi-page transcripts are truncated with a
# head+tail split, so last-page totals and charges are never dropped.
INV_MAX_STRUCTURING_CHARS=12000

# ── Multi-agent validation loop (day 2) ───────────────────────────────
# Hard cap on correction iterations; the loop cannot exceed this.
INV_MAX_RETRIES=3

# ── Fast testing mode (--fast) ────────────────────────────────────────
# Set INV_FAST=true (or pass --fast on the CLI) to trade a little extraction
# precision for dramatically lower latency / token spend:
#   - pages with >50 chars of text skip rasterisation + the vision LLM,
#   - inter-page vision pacing is disabled,
#   - the correction loop caps at 0 (single pass),
#   - structuring uses the lightweight model below and a 4000-char input cap.
INV_FAST=false
INV_FAST_STRUCTURING_MODEL=openai/gpt-oss-20b
INV_FAST_TEXT_LAYER_MIN_CHARS=50
INV_FAST_MAX_RETRIES=0
INV_FAST_MAX_INPUT_CHARS=4000

# Fast mode shares the 8192 output budget: a smaller cap truncated
# multi-line payables JSON on the gpt-oss models and yielded empty payables.
INV_FAST_MAX_TOKENS=8192

# ── LLM manual trigger ────────────────────────────────────────────────
# The default run is fully local: image-only pages are transcribed by easyocr
# OCR and the Vision LLM is never called (zero vision tokens spent). Set
# INV_USE_LLM=true (or pass --use-llm on the CLI) to additionally route the
# pages easyocr cannot read to the multimodal Vision model.
INV_USE_LLM=false

# Page images below this many chars on the embedded text layer are treated
# as scans and routed to the vision model.
INV_TEXT_LAYER_MIN_CHARS=80

# Fail hard (True) or return empty text (False) when an image-only page
# cannot be transcribed because no API key is configured.
INV_REQUIRE_VISION=False

INV_LOG_LEVEL=INFO